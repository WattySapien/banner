{
  "name": "@clipx/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import tsx src/local-server.ts",
    "build": "esbuild src/local-server.ts --bundle --platform=node --packages=external --format=esm --target=node20 --outfile=dist/local-server.js",
    "start": "NODE_ENV=production node dist/local-server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "migrate:sqlite": "node --import tsx scripts/migrate-sqlite.ts",
    "bootstrap-admin": "node --import tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@clipx/contracts": "1.0.0",
    "@clipx/database": "1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "postgres": "^3.4.7",
    "serverless-http": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.3",
    "typescript": "5.6.3"
  }
}
