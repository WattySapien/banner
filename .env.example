# Optional for local development; required for Vercel and Netlify production.
DATABASE_URL=postgresql://postgres.project:password@region.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_DAYS=7
# Server-only 32-byte base64 key. Generate locally with: openssl rand -base64 32
CARD_DATA_ENCRYPTION_KEY=
HOST=127.0.0.1
PORT=5000

# Set this only in the Ardenvia Bank web Vercel project. It is server-only.
API_ORIGIN=https://your-ardenvia-bank-api-project.vercel.app

# Local browser automation only. Never configure these in Netlify or Vercel.
# Use a dedicated development/test database and copy DATABASE_URL exactly.
AUTOMATION_DATABASE_MUTATIONS=false
AUTOMATION_DATABASE_URL=
AUTOMATION_BALANCE_RESERVE=100
# Non-interactive automation only; interactive runs request a masked password.
# CLIPX_* names are legacy compatibility names retained for existing deployments.
CLIPX_AUTOMATION_PASSWORD=
# Optional when the local API uses SQLite.
CLIPX_DATABASE_PATH=
