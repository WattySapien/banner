{
  "name": "ardenvia-bank-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @clipx/api",
    "dev:web": "npm run dev --workspace @clipx/web",
    "dev:netlify:web": "npm run dev:netlify:web --workspace @clipx/web",
    "predev:netlify": "node scripts/prepare-netlify-dev.mjs",
    "dev:netlify": "netlify dev --filter @clipx/web --no-open --skip-gitignore",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:automation": "node --import tsx --test automation/*.test.js",
    "db:generate": "npm run db:generate --workspace @clipx/database",
    "db:migrate": "npm run db:migrate --workspace @clipx/database",
    "db:migrate:sqlite": "npm run migrate:sqlite --workspace @clipx/api",
    "db:bootstrap-admin": "npm run bootstrap-admin --workspace @clipx/api",
    "start": "npm run start --workspace @clipx/api",
    "automate": "node automation/clipx-automation.js"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.1",
    "postgres": "^3.4.7",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.20.3",
    "typescript": "5.6.3"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
